import csv
import os
import re

# Load the configuration file
locals().update(config)

# ==========================================
# Config Path Resolution
# ==========================================
# Resolve relative paths in config relative to the configfile's directory so that
# snakemake can be invoked from any working directory:
#   snakemake -s /path/to/Snakefile --configfile /path/to/config.yaml
_CONFIG_DIR = (
    os.path.dirname(os.path.abspath(workflow.configfiles[0]))
    if getattr(workflow, "configfiles", None)
    else os.getcwd()
)


def _resolve_config_path(p):
    """Return p as an absolute path resolved relative to the config file's directory."""
    if not p or os.path.isabs(p):
        return p
    return os.path.normpath(os.path.join(_CONFIG_DIR, p))


# Normalize relative paths in config before included modules consume them.
config["downstream_scripts_dir"] = _resolve_config_path(
    config.get("downstream_scripts_dir", "")
)

# ==========================================
# Samplesheet Integration
# ==========================================
def _load_samplesheet(path):
    sheet = {}
    with open(path) as f:
        for row in csv.DictReader(f):
            key = (row["conditions"], row["samples"])
            sheet[key] = {
                "fastq_1": row["fastq_1"],
                "fastq_2": row.get("fastq_2", "").strip(),
            }
    return sheet


SAMPLESHEET = _load_samplesheet(
    _resolve_config_path(config.get("samplesheet", "samplesheet.csv"))
)

# Populate config from samplesheet so tools.smk and downstream.smk work unchanged.
config["conditions"] = sorted(set(k[0] for k in SAMPLESHEET))
config["samples"] = sorted(set(k[1] for k in SAMPLESHEET))

# Aligners to run — consumed by rule all and downstream rules.
_ALIGNERS = config.get("aligners", ["star"])

# JACUSA2 differential comparison (optional). When `jacusa2_comparison` names two
# condition groups, JACUSA2 runs a call-2 contrast between them and its outputs are
# produced/parsed/plotted. When the key is absent, JACUSA2 is skipped everywhere.
# condition1 → JACUSA2 bases1* group (left figure panel); condition2 → bases2* (right).
# The downstream JSON keys, table rows, and figure panels are labeled with the real
# condition1/condition2 names, so any ordering is labeled truthfully.
JACUSA2_COMPARISON = config.get("jacusa2_comparison")
_RUN_JACUSA2 = bool(JACUSA2_COMPARISON)
# Defaults are only used as harmless placeholders when JACUSA2 is disabled (JACUSA2.py
# does not run, and Multiple-Analysis.py keeps its hard-coded conditions in that path).
_JAC_C1, _JAC_C2 = "WT", "ADAR1KO"
if _RUN_JACUSA2:
    _JAC_C1 = JACUSA2_COMPARISON.get("condition1")
    _JAC_C2 = JACUSA2_COMPARISON.get("condition2")
    _missing = [c for c in (_JAC_C1, _JAC_C2) if c not in config["conditions"]]
    if None in (_JAC_C1, _JAC_C2) or _missing:
        raise ValueError(
            "jacusa2_comparison requires condition1/condition2 present in samplesheet "
            "conditions {}; got {}".format(config["conditions"], (_JAC_C1, _JAC_C2))
        )

# Per-sample tools included in BigBed and comparison matrices. The call-2 JACUSA2
# contrast ("jacusa2") is excluded because it produces one comparison file per
# aligner, not per sample; JACUSA2 call-1 ("jacusa2_call1") is per-sample and is
# kept so its reference-genome edit set is compared against the other tools.
_BED_TOOLS = [t for t in config.get("visualization", {}).get("tools", [
    "reditools", "reditools3", "sprint", "red_ml",
    "bcftools", "redinet", "jacusa2_call1",
]) if t not in ("jacusa2",)]

# Edit type baked into the MARINE filtered-output filename (see filter_marine_by_edit_type
# in rules/tools.smk). e.g. "AG".
_MARINE_EDIT_TYPE = config["params"]["common"]["edit_type"]

# Strandedness — single source of truth. params.common.strandedness is one of
# "unstranded" | "stranded" | "reverse_stranded" and is translated to each tool's
# own flag encoding here, so every caller is configured consistently from one key.
# Semantics verified against each tool's CLI help/source:
#   reditools.py / reditools3 / REDItoolDnaRna.py  -s 0/1/2
#       0=unstranded, 1=second-strand (read1 forward), 2=first-strand (read1 reverse, dUTP)
#   MARINE  --strandedness 0/1/2  (same 0/1/2 meaning)
#   JACUSA2 -P  UNSTRANDED / FR-SECONDSTRAND / RF-FIRSTSTRAND
_STRAND_FLAGS = {
    "unstranded":       {"reditools": "0", "marine": "0", "jacusa2": "UNSTRANDED"},
    "stranded":         {"reditools": "1", "marine": "1", "jacusa2": "FR-SECONDSTRAND"},
    "reverse_stranded": {"reditools": "2", "marine": "2", "jacusa2": "RF-FIRSTSTRAND"},
}
_STRANDEDNESS = config["params"]["common"]["strandedness"]
if _STRANDEDNESS not in _STRAND_FLAGS:
    raise ValueError(
        "params.common.strandedness must be one of {}; got {!r}".format(
            list(_STRAND_FLAGS), _STRANDEDNESS
        )
    )
# Consumed by the caller rules in rules/tools.smk.
config["strand_flags"] = _STRAND_FLAGS[_STRANDEDNESS]


def is_paired(condition, sample):
    """Return True if this condition/sample has R2 reads in the samplesheet."""
    return bool(SAMPLESHEET.get((condition, sample), {}).get("fastq_2", ""))


def samplesheet_fastq_path(wildcards):
    """Return the source FASTQ.GZ path for a given condition/sample/read wildcard."""
    key = (wildcards.condition, wildcards.sample)
    info = SAMPLESHEET[key]
    if wildcards.read == "R1":
        return info["fastq_1"]
    fastq_2 = info.get("fastq_2", "")
    if not fastq_2:
        raise ValueError(f"No R2 fastq for {wildcards.condition}_{wildcards.sample}")
    return fastq_2


# ==========================================
# Container Resolution
# ==========================================
SIF_DIR = config.get(
    "singularity_image_dir",
    "/tscc/projects/ps-yeolab3/bay001/codebase/rna-editing/singularity",
)
CONTAINERS = config.get("containers", {})


def container_for(tool):
    """Return the configured Singularity image path for a workflow tool."""
    return CONTAINERS.get(tool, f"{SIF_DIR}/{tool}.sif")


# Prevent wildcards from crossing file-path boundaries (dots, slashes).
wildcard_constraints:
    condition="[^/._]+",
    sample="[^/._]+",
    wgs_sample="[^/._]+",
    aligner="[^/._]+",
    tool="[a-z0-9_]+",
    chrom="[^/]+"

# ==========================================
# Target Outputs
# ==========================================
# rule all is defined here (top-level Snakefile) so Snakemake 9 picks it up
# as the default target. Defining it in an included file causes Snakemake 9
# to use the first rule from the first included file instead.

_WGS_DB_FILES = (
    [
        os.path.join(config["references"]["db_path"], f)
        for f in ["HEK293T_hg38_clean.json", "REDIportal.json", "Alu_GRCh38.json"]
    ]
    if config.get("wgs_samples") else []
)

rule all:
    input:
        # Preprocessing outputs (one BAM per aligner per sample)
        expand("results/mapped/{aligner}/{condition}_{sample}.rmdup.bam",
               aligner=_ALIGNERS, condition=config["conditions"], sample=config["samples"]),
        # Tool outputs (one result per aligner per sample / per aligner for JACUSA2)
        expand("results/tools/{aligner}/reditools/{condition}_{sample}.output",
               aligner=_ALIGNERS, condition=config["conditions"], sample=config["samples"]),
        expand("results/tools/{aligner}/bcftools/{condition}_{sample}.bcf",
               aligner=_ALIGNERS, condition=config["conditions"], sample=config["samples"]),
        expand("results/tools/{aligner}/jacusa2/Jacusa.out", aligner=_ALIGNERS) if _RUN_JACUSA2 else [],
        # Reference databases — built from WGS alignment when wgs_samples is configured
        _WGS_DB_FILES,
        # Downstream analysis — single run that processes all aligners together
        "results/downstream/multiple_analysis.done",
        # Downstream JSON outputs (per-tool site summaries)
        "results/downstream/Data_REDItool2.json",
        "results/downstream/Data_SPRINT.json",
        "results/downstream/Data_REDML.json",
        "results/downstream/Data_BCFTools.json",
        (["results/downstream/Data_JACUSA2.json"] if _RUN_JACUSA2 else []),
        "results/downstream/Data_REDItools2-Multiple.json",
        "results/downstream/Data_SPRINT-Multiple.json",
        "results/downstream/Data_BCFTools-Multiple.json",
        "results/downstream/Data_REDML-Multiple.json",
        # Downstream comparison figures and tables
        "results/downstream/Downstream/IndividualCompare.png",
        "results/downstream/Downstream/MultipleCompare.png",
        "results/downstream/Downstream/REDItools2_Table.csv",
        "results/downstream/Downstream/BCFTools_Table.csv",
        "results/downstream/Downstream/REDItools2-Multiple_Table.csv",
        "results/downstream/Downstream/BCFTools-Multiple_Table.csv",
        (["results/downstream/Downstream/JACUSA2_Table.csv"] if _RUN_JACUSA2 else []),
        # REDItools3 outputs (one per aligner per sample)
        expand("results/tools/{aligner}/reditools3/{condition}_{sample}.txt",
               aligner=_ALIGNERS, condition=config["conditions"], sample=config["samples"]),
        # MARINE edit-type-filtered outputs (one per aligner per sample)
        expand("results/tools/{aligner}/marine/{condition}_{sample}/final_filtered_site_info." + _MARINE_EDIT_TYPE + ".tsv",
               aligner=_ALIGNERS, condition=config["conditions"], sample=config["samples"]),
        # REDInet step 2: bgzip+tabix indexed REDItoolDnaRna.py output
        expand("results/tools/{aligner}/reditools_redinet/{condition}_{sample}/{condition}_{sample}.output.gz",
               aligner=_ALIGNERS, condition=config["conditions"], sample=config["samples"]),
        # REDInet step 3: predictions per aligner per sample
        expand("results/tools/{aligner}/redinet/{condition}_{sample}.predictions.tsv",
               aligner=_ALIGNERS, condition=config["conditions"], sample=config["samples"]),
        # Cross-tool comparison matrices
        "results/compare_all_tools/edit_coverage_matrix.tsv",
        "results/compare_all_tools/edit_fraction_matrix.tsv",
        "results/compare_all_tools/tool_score_matrix.tsv",
        # Intersection co-call table + per-output-type correlation (replaces the
        # old mixed tool_correlation heatmap)
        expand("results/correlation/intersect/edits_intersect_{aligner}.tsv", aligner=_ALIGNERS),
        expand("results/correlation/intersect/tool_jaccard_{aligner}.tsv", aligner=_ALIGNERS),
        expand("results/correlation/by_output_type/per-site-fraction-correlation_{aligner}.tsv", aligner=_ALIGNERS),
        expand("results/correlation/by_output_type/per-gene-fraction-correlation_{aligner}.tsv", aligner=_ALIGNERS),
        expand("results/correlation/by_output_type/qual-or-score-correlation_{aligner}.tsv", aligner=_ALIGNERS),
        expand("results/correlation/by_output_type/read-count-correlation_{aligner}.tsv", aligner=_ALIGNERS),
        # Consensus characteristics — intersection (>=2,>=3,...) vs outersection (=1)
        # per-site and per-gene, plus the gene-fraction anticorrelation diagnostic.
        expand("results/consensus/site_characteristics_{aligner}.tsv", aligner=_ALIGNERS),
        expand("results/consensus/gene_characteristics_{aligner}.tsv", aligner=_ALIGNERS),
        expand("results/consensus/anticorrelation_gene_fraction_{aligner}.tsv", aligner=_ALIGNERS),
        expand("results/consensus/consensus_report_{aligner}.md", aligner=_ALIGNERS),
        # Aligner correlation (per-tool, across aligners) — unchanged
        expand("results/correlation/aligner_correlation_{tool}.tsv", tool=_BED_TOOLS),
        # Coverage BigWig (one per BAM)
        expand("results/bigwig/{aligner}/{condition}_{sample}.bw",
               aligner=_ALIGNERS, condition=config["conditions"], sample=config["samples"]),
        # Edit-site BigBed (one per tool per aligner per sample)
        expand("results/bigbed/{tool}/{aligner}/{condition}_{sample}.bb",
               tool=_BED_TOOLS, aligner=_ALIGNERS,
               condition=config["conditions"], sample=config["samples"]),
        # UCSC trackhub hub descriptor
        "results/trackhub/hub.txt",


include: "rules/morales_main.smk"
include: "rules/visualization.smk"
